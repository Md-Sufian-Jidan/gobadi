model Address {
  id          Int      @id @default(autoincrement())
  userId      Int
  label       String
  contactName String
  phone       String
  division    String
  district    String
  upazila     String
  postalCode  String
  latitude    Float?
  longitude   Float?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}
